# Database Configuration
# By default in local dev, SQLAlchemy falls back to sqlite:///./brasileirao.db
# For PostgreSQL (Docker / Supabase), uncomment below:
# DATABASE_URL=postgresql+psycopg2://brasileirao:brasileirao_secret@localhost:5432/brasileirao_analytics

# Redis Cache (Optional in local dev, falls back to in-memory TTL cache)
REDIS_URL=redis://localhost:6379/0

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
